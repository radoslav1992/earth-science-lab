---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="This page has moved or never existed. Try the Earthquake Epicenter Finder, the classroom activity or the teacher resources." noindex ads={false}>
  <div class="wrap">
    <div class="page-intro">
      <span class="eyebrow">404</span>
      <h1>This page shifted along a fault</h1>
      <p class="lede">We couldn’t find that page. It may have moved, or the link may be mistyped.</p>
      <div class="page-actions">
        <a class="btn primary" href="/tools/earthquake-epicenter/">Earthquake Epicenter Finder</a>
        <a class="btn" href="/teachers/">For teachers</a>
        <a class="btn" href="/">Home</a>
      </div>
    </div>
  </div>
</Layout>
