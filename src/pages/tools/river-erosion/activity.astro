---
import Layout from '../../../layouts/Layout.astro';
import RecordTable from '../../../components/RecordTable.astro';
import ClassroomShare from '../../../components/ClassroomShare.astro';
import { riverActivity as act, standards, MINUTES } from '../../../lib/activities/river-erosion.mjs';
import { hjulstromSvg } from '../../../lib/river-svg.mjs';
import '../../../components/river/river.css';

const url = new URL('/tools/river-erosion/activity/', Astro.site).href;
const description = `Free printable erosion and deposition worksheet for ${act.grade.toLowerCase()}: run a virtual stream table, measure erosion and read the Hjulström diagram. ${act.minutes} minutes.`;
const diagram = hjulstromSvg({ label: 'Hjulström diagram: water speed in cm/s against grain size in mm, with erosion, transport and deposition zones' });
const resource = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: act.title,
  description: act.goal,
  url,
  learningResourceType: 'Worksheet',
  educationalLevel: act.grade,
  timeRequired: `PT${act.minutes}M`,
  isAccessibleForFree: true,
  inLanguage: 'en',
  educationalAlignment: act.standards.map(code => ({ '@type': 'AlignmentObject', alignmentType: 'educationalSubject', educationalFramework: 'Next Generation Science Standards', targetName: code })),
};
---
<Layout title={`${act.title}: Free Printable Worksheet`} description={description} section="River Erosion" crumbs={[['River Erosion Sandbox', '/tools/river-erosion/'], ['Classroom activity']]}>
  <article class="worksheet">
    <div class="breadcrumb no-print"><a href="/tools/river-erosion/">{act.toolName}</a> / Classroom activity</div>
    <header class="worksheet-head">
      <div>
        <span class="eyebrow">Student activity · {act.grade} · about {act.minutes} minutes</span>
        <h1>{act.title}</h1>
      </div>
      <div class="name-lines" aria-hidden="true"><span>Name</span><span>Class</span><span>Date</span></div>
    </header>
    <p class="worksheet-goal"><strong>Goal:</strong> {act.goal}</p>
    <p class="worksheet-meta">Open the sandbox at <strong>earthsciencelab.org/tools/river-erosion/</strong> · Connects to NGSS {act.standards.join(', ')}</p>
    <div class="page-actions no-print">
      <button class="btn primary" type="button" data-print>Print worksheet</button>
      <a class="btn" href="/tools/river-erosion/">Open the sandbox</a>
      <ClassroomShare url={url} />
    </div>
    <div class="rv-worksheet-top">
      <figure class="rv-figure">
        <Fragment set:html={diagram} />
        <figcaption>Hjulström diagram (approximate). Clay 0.002 mm, silt 0.02, fine sand 0.2, coarse sand 1, gravel 3 mm.</figcaption>
      </figure>
      <div>
        <h2>What to do</h2>
        <ol class="steps">{act.steps.map(step => <li>{step}</li>)}</ol>
      </div>
    </div>
    <h2>Record your results (after {MINUTES} minutes)</h2>
    <RecordTable act={act} />
    <h2>Questions</h2>
    <ol class="questions">
      {act.questions.map(q => <li><p>{q.q}</p><div class="write-lines" aria-hidden="true">{Array.from({ length: q.lines }, () => <span />)}</div></li>)}
    </ol>
    <p class="worksheet-foot">Free from Earth Science Lab · earthsciencelab.org<span class="no-print"> · {act.standards.map(code => `${code}: ${standards[code]}`).join(' ')}</span></p>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(resource)} />
</Layout>
