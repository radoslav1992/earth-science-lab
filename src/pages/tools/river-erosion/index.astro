---
import Layout from '../../../layouts/Layout.astro';
import RiverSandbox from '../../../components/river/RiverSandbox.astro';
import ClassroomShare from '../../../components/ClassroomShare.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Faq from '../../../components/Faq.astro';
import { site } from '../../../lib/site.mjs';
import {
  DEFAULT_STATE, GRAINS, TIME_RANGE, CHANNEL_WIDTH, BEND_FACTOR,
  simulate, measure, flowSpeed, erosionSpeed, settlingSpeed, grainById, fmt, fmtSpeed, fmtVolume, fmtDepth, fmtThreshold,
} from '../../../lib/river.mjs';
import { PLAN, PROFILE, planInner, profileInner, describePlan, describeProfile, hjulstromSvg } from '../../../lib/river-svg.mjs';

const title = 'River Erosion Sandbox – Virtual Stream Table Simulation';
const description = 'Tilt a virtual stream table, change the water flow and the sediment, and watch a river erode its channel and build a delta. Free, with a Hjulström diagram.';
const url = new URL('/tools/river-erosion/', Astro.site).href;

// Worked example: the sandbox's opening setup, computed by the model at build time.
const ex = DEFAULT_STATE;
const run = simulate(ex);
const sand = grainById(ex.grain);
const m = measure(run, ex.t);
const ve = erosionSpeed(sand.mm);
// When does the river stop cutting down? The first half-minute when the water is too slow to lift fine sand.
let stopsAt = TIME_RANGE[1];
for (let t = 0; t <= TIME_RANGE[1]; t += 0.5) if (measure(run, t).speedNow < ve) { stopsAt = t; break; }
const doubleFlow = flowSpeed(2 * ex.flow, ex.slope) / flowSpeed(ex.flow, ex.slope);
const doubleSlope = flowSpeed(ex.flow, 2 * ex.slope) / flowSpeed(ex.flow, ex.slope);
const pct = (ratio: number) => Math.round((ratio - 1) * 100);
const attr = (text: string) => text.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const worked = {
  plan: `<svg class="rv-plan" viewBox="0 0 ${PLAN.width} ${PLAN.height}" role="img" aria-label="${attr(describePlan(run, ex.t))}">${planInner(run, ex.t)}</svg>`,
  profile: `<svg class="rv-profile" viewBox="0 0 ${PROFILE.width} ${PROFILE.height}" role="img" aria-label="${attr(describeProfile(run, ex.t))}">${profileInner(run, ex.t)}</svg>`,
};
const cups = Math.round(m.eroded / 240); // a US cup is about 240 cm³
const diagram = hjulstromSvg({ label: 'Hjulström diagram: the speed needed to erode each grain size, and the speed below which it settles. Sand, around 0.3 mm, is easiest to erode, at about 20 cm/s. Silt and clay need faster water because they stick together; gravel needs faster water because it is heavy.' });

const faq: [string, string][] = [
  ['What is the difference between erosion, transport and deposition?', 'Erosion is when moving water picks up sediment and carries it away from where it was. Transport is the sediment being carried along: rolled, bounced or floating in the water. Deposition is when the water slows down and drops it. One river does all three: it erodes where it is fast, carries sediment downstream, and deposits it where it slows, such as on the inside of bends and where it meets a lake or the sea.'],
  ['What does the Hjulström curve show?', 'The Hjulström curve (or Hjulström diagram) shows how fast water must flow to pick up grains of each size, and how slow it must get before moving grains settle out. Sand is the easiest to pick up, at about 20 cm/s. Gravel needs faster water because it is heavy; silt and clay also need faster water, because their tiny grains stick together. Filip Hjulström published it in 1935; the curves are approximate, because real thresholds depend on water depth and how firmly the grains are packed.'],
  ['Why is sand easier to erode than clay?', 'Clay grains are thousands of times smaller than sand grains, but they are flat flakes that stick to each other and settle into a smooth, firm layer. Water slides over that layer instead of grabbing single grains, so it takes much faster water to tear clay up. Sand grains are loose and stick out into the flow, so a gentle current can roll them along.'],
  ['How does a river build a delta?', 'Where a river flows into a lake or the sea, it spreads out into still water and slows down. Slower water can carry less sediment, so the river drops it: the coarsest grains first, close to the mouth, and finer ones farther out. Layer by layer the deposit builds up to the water surface and pushes the shoreline outward. The Mississippi and the Nile have built huge deltas this way.'],
  ['Why do rivers have point bars and cut banks?', 'As water goes around a bend it flows faster on the outside and slower on the inside. The fast water on the outside erodes the bank, making a steep cut bank. The slow water on the inside can’t carry as much, so it drops sand and gravel there, building a gently sloping point bar. Over time this makes bends grow and move, which is why rivers meander.'],
  ['What is a stream table?', 'A stream table is a tilted tray of sand or soil with water running down it. Geologists and teachers use stream tables to watch erosion and deposition happen in minutes instead of years. You can build one with a plastic storage box, a hose or a jug of water, and a bucket under a drain hole. This sandbox lets you try many settings quickly, and the same experiments work in a real one.'],
  ['Can I use the River Erosion Sandbox in class?', 'Yes. It is free with no sign-up and runs on school Chromebooks. Use the printable activity to compare four setups and read the Hjulström diagram, then let students try Challenge mode, eight questions answered with the sandbox. Teachers can find the answer key on the For teachers page.'],
];

const appData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'River Erosion Sandbox',
  url,
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any (web browser)',
  isAccessibleForFree: true,
  inLanguage: 'en',
  educationalLevel: 'Middle school and early high school (ages 10–16)',
  publisher: { '@type': 'Organization', name: site.name, url: site.url + '/' },
};
---
<Layout title={title} description={description} section="River Erosion" crumbs={[['River Erosion Sandbox']]}>
  <div class="wrap">
    <div class="page-intro">
      <span class="eyebrow">Virtual lab · Rivers and erosion</span>
      <h1>River Erosion Sandbox</h1>
      <p class="lede">Tilt a stream table, turn up the water and choose the sediment. Watch the river cut its channel, carry sand downstream and drop it on bends and in a delta, then read why on the Hjulström diagram.</p>
      <div class="page-actions">
        <a class="btn" href="/tools/river-erosion/activity/">Printable activity</a>
        <ClassroomShare url={url} />
      </div>
    </div>

    <RiverSandbox />

    <section class="section prose" aria-labelledby="processes">
      <h2 id="processes">How a river erodes, carries and drops sediment</h2>
      <p>Running water is one of the main forces that shape Earth’s surface. It wears valleys into mountains and builds new land at the coast. Everything it does comes down to three processes, and which one happens depends on how fast the water flows and how big the grains are.</p>
      <ol class="steps-list">
        <li><strong>Erosion.</strong> Fast water drags on the grains of the stream bed. When the drag is strong enough, it lifts or rolls them away, and the channel gets deeper and wider. In the sandbox this happens where the water flows faster than the grain’s erosion speed.</li>
        <li><strong>Transport.</strong> Once grains are moving, they keep going even if the water slows a little. Big grains roll and bounce along the bed; fine grains float in the water and make it look muddy. A river can only carry so much: the faster it flows, the more it can carry.</li>
        <li><strong>Deposition.</strong> Where the water slows down, it can’t carry everything, so it drops the extra: the biggest grains first. Rivers slow on the inside of bends, where the land flattens out, and most of all where they flow into a lake or the sea. That is where you find sandbars, floodplains and deltas.</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="hjulstrom" style="padding-top:0">
      <div class="worked">
        <div class="prose">
          <h2 id="hjulstrom">Reading the Hjulström diagram</h2>
          <p>In 1935 the Swedish geographer Filip Hjulström drew a famous diagram from river measurements. It shows <strong>grain size</strong> along the bottom and <strong>water speed</strong> up the side, both on log scales where each step is ten times bigger.</p>
          <ul>
            <li>Above the top curve, grains are <strong>eroded</strong>: picked up from the bed.</li>
            <li>Between the curves, grains that are already moving are <strong>transported</strong>, but grains lying on the bed stay put.</li>
            <li>Below the lower curve, moving grains settle out: they are <strong>deposited</strong>.</li>
          </ul>
          <p>The surprise is the shape of the top curve. It dips lowest for sand: fine sand is picked up at about {fmtThreshold(erosionSpeed(0.2))} cm/s. Gravel needs faster water because it is heavier. But silt and clay, which are far smaller and lighter than sand, also need faster water, because their tiny flakes stick together into a smooth layer. Once clay is floating, though, it sinks so slowly that almost any current keeps it moving, which is why muddy rivers stay muddy.</p>
        </div>
        <figure class="rv-figure">
          <Fragment set:html={diagram} />
          <figcaption>Approximate curves after Hjulström (1935) and Sundborg (1956) for rivers about 1 m deep. The lower curve is the speed each grain sinks in still water (Ferguson and Church, 2004).</figcaption>
        </figure>
      </div>
      <div class="rv-compare" style="margin-top:22px">
        <div class="table-wrap">
          <table>
            <caption class="visually-hidden">Approximate erosion and settling speeds for the sandbox’s five sediments</caption>
            <thead><tr><th scope="col">Sediment</th><th scope="col">Typical grain size</th><th scope="col">Picked up above about</th><th scope="col">Settles below about</th><th scope="col">What it is like</th></tr></thead>
            <tbody>
              {GRAINS.map(g => (
                <tr>
                  <th scope="row">{g.name}</th>
                  <td>{fmt(g.mm, 3)} mm</td>
                  <td>{fmtThreshold(erosionSpeed(g.mm))} cm/s</td>
                  <td>{fmtThreshold(settlingSpeed(g.mm))} cm/s</td>
                  <td>{g.note[0].toUpperCase() + g.note.slice(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="muted" style="margin-top:10px">Grain-size names follow the Wentworth scale: clay is smaller than 1/256 mm, silt up to 1/16 mm, sand up to 2 mm, and gravel bigger than that.</p>
      </div>
    </section>

    <section class="section prose" aria-labelledby="slope" style="padding-top:0">
      <h2 id="slope">Why slope and water flow matter</h2>
      <p>Water runs faster down a steeper slope, and a bigger flow runs faster too, because deeper water is held back less by the bed. Engineers work out river speeds with Manning’s equation, and the sandbox uses it for a channel {CHANNEL_WIDTH} cm wide. In this tray, doubling the water flow makes the water about {pct(doubleFlow)}% faster, and doubling the slope makes it about {pct(doubleSlope)}% faster. Faster water erodes more and can carry more, so steep mountain streams cut deep valleys while slow lowland rivers drop sediment on their floodplains.</p>
      <p>Rivers also change their own slopes. A river that carries away more than it receives cuts down, and its slope gets gentler, until the water is just too slow to pick up more grains. Rivers can’t cut much below the level of the sea they flow into, which geologists call their <strong>base level</strong>. A river that is given more sediment than it can carry does the opposite: it drops the extra and builds up, steepening its slope, the way an alluvial fan grows where a mountain stream reaches flat ground. Try both in the sandbox: clear water on a steep slope, then lots of sediment fed in on a gentle one.</p>
    </section>

    <section class="section" aria-labelledby="worked" style="padding-top:0">
      <h2 id="worked">Worked example: the sandbox’s opening setup</h2>
      <div class="worked">
        <div class="prose">
          <p>The sandbox opens with {sand.name.toLowerCase()} ({fmt(sand.mm, 3)} mm), a {fmt(ex.slope)}% slope, {fmt(ex.flow)} liters of water a minute and no extra sediment fed in.</p>
          <h3>1. Will the water erode?</h3>
          <p>Manning’s equation gives a starting speed of about <strong>{fmtSpeed(m.startSpeed)} cm/s</strong>. On the Hjulström diagram, fine sand is picked up above about {fmtThreshold(ve)} cm/s, so the water erodes.</p>
          <h3>2. After {fmt(ex.t)} minutes</h3>
          <p>The river has eroded about <strong>{fmtVolume(m.eroded)} cm³</strong> of sand, about {cups <= 1 ? 'a cupful' : cups + ' cupfuls'}, and cut down {fmtDepth(m.deepestCut)} cm at its deepest, near the inlet where clear water first hits the sand. About {fmtVolume(m.seaDeposit)} cm³ was dropped in the sea, building a delta {m.deltaLength} cm long, and about {fmtVolume(m.landDeposit)} cm³ was dropped in the channel just before the sea, where the water starts to slow.</p>
          <h3>3. The river slows itself down</h3>
          <p>As the channel cuts down, its slope gets gentler and the water slows: to about {fmtSpeed(m.speedNow)} cm/s after {fmt(ex.t)} minutes. By about {Math.round(stopsAt)} minutes it has slowed to just under the {fmtThreshold(ve)} cm/s needed to lift fine sand, and the channel stops cutting down. The river has reached a balance with its slope.</p>
          <p>Change one thing at a time in the sandbox, such as the slope, and compare the numbers. That is how scientists run a fair test.</p>
        </div>
        <div class="rv-views">
          <figure class="rv-figure"><Fragment set:html={worked.plan} /><figcaption>After {fmt(ex.t)} minutes, from above: the valley the river cut, point bars on the inside of bends, cut banks on the outside, and the delta.</figcaption></figure>
          <figure class="rv-figure"><Fragment set:html={worked.profile} /><figcaption>The same run from the side, heights stretched two times. Pink is sand cut away; gold is sand laid down.</figcaption></figure>
        </div>
      </div>
    </section>

    <AdSlot type="native" />

    <section class="section prose" aria-labelledby="mistakes">
      <h2 id="mistakes">Common misconceptions</h2>
      <ul>
        <li><strong>“The smallest grains are always the easiest to wash away.”</strong> Not once they have settled. Clay and silt stick together, so they need faster water than sand to be picked up. They are only easy to carry once they are already floating.</li>
        <li><strong>“Rivers only erode.”</strong> Every river erodes, transports and deposits. It erodes where it is fast and deposits where it slows, often in the same bend.</li>
        <li><strong>“Erosion and weathering are the same thing.”</strong> Weathering breaks rock into pieces where it is. Erosion moves the pieces somewhere else.</li>
        <li><strong>“Faster water always builds a bigger delta.”</strong> Only if the river carries grains that settle near the coast. Fine silt and clay can stay in the water and drift far out to sea instead.</li>
        <li><strong>“A river keeps cutting down forever.”</strong> As it cuts down, its slope gets gentler and the water slows. It can’t cut much below the level of the sea or lake it flows into.</li>
      </ul>
      <h2>What this model simplifies</h2>
      <p>The sandbox is a model of a stream table, and a stream table is itself a small model of a river valley: a real river takes years to thousands of years to do what the tray does in minutes, and the animation runs faster still. The water’s speed comes from Manning’s equation for a channel that stays {CHANNEL_WIDTH} cm wide, with one roughness for every sediment. The model works along the middle of the channel: the bends are drawn to show where water is faster and slower (about {Math.round(BEND_FACTOR * 100)}% either way), but depths and volumes are worked out down the middle, with banks that always slump at the same angle. Each run uses one size of sediment, not a mix, with no plants, rain or rock except the bottom of the tray. The erosion and settling speeds are approximate readings of Hjulström’s diagram for rivers about 1 m deep; in the shallow water of a real stream table, grains start moving at somewhat lower speeds, and real thresholds vary a lot. How much sediment the water can carry follows a simple rule chosen so the tray moves a few hundred cubic centimeters of sand in ten minutes, as real stream tables do. Volumes are loose, wet sediment, rounded to two figures.</p>
    </section>

    <section class="section" aria-labelledby="activity">
      <div class="featured">
        <div>
          <span class="eyebrow">For the classroom</span>
          <h2 id="activity">Erosion and deposition activity</h2>
          <p>A one-page printable worksheet for grades 6–10, about 15 minutes: students run four stream-table setups, record the water speed, the sediment eroded, the deepest cut and the delta length, then answer six questions, including two that read the Hjulström diagram. It connects to NGSS MS-ESS2-2 and HS-ESS2-5, and works as a measuring-erosion lesson (4-ESS2-1) with younger students.</p>
          <div class="page-actions">
            <a class="btn primary" href="/tools/river-erosion/activity/">Open the activity</a>
            <a class="btn" href="/teachers/">For teachers</a>
          </div>
        </div>
        <div>
          <p class="muted">Share the sandbox with your class in one click. Students need no accounts or logins.</p>
          <ClassroomShare url={url} />
        </div>
      </div>
    </section>

    <Faq items={faq} title="River erosion questions" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(appData)} />
</Layout>
