---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import ClassroomShare from '../../components/ClassroomShare.astro';
import { activities, standards } from '../../lib/activities.mjs';
import { site } from '../../lib/site.mjs';
import { anyAds } from '../../lib/ads.mjs';

const toolUrl = (act: { tool: string }) => new URL(`/tools/${act.tool}/`, Astro.site).href;
const tracking = site.analyticsId
  ? 'The site uses Google Analytics for anonymous, aggregated usage statistics, and asks for consent first where the law requires it.'
  : 'The site currently runs no analytics.';
const adsLine = anyAds
  ? 'Students who open a tool from Google Classroom, Canvas or Schoology, or through a Share to Google Classroom link on this site, see no ads on that device for 30 days.'
  : 'There are no ads on Earth Science Lab today. If ads are added later, students who arrive from Google Classroom, Canvas or Schoology, or through a Share to Google Classroom link, will not see them, and teacher pages will stay ad-free.';

// How to open and close each lab's lesson, keyed by tool; the shared plan is in the list below.
const lessonNotes: Record<string, { hook: string; debrief: string; tip: string }> = {
  'earthquake-epicenter': {
    hook: '“Three towns felt the same earthquake. How could we work out where it started?”',
    debrief: 'Why did we need three stations? Why don’t the circles meet perfectly?',
    tip: 'Keep “Snap to arrivals” on for younger students.',
  },
  'plate-tectonics': {
    hook: '“Iceland and Japan both have volcanoes. Why are Japan’s earthquakes so much deeper?”',
    debrief: 'Which boundaries make deep earthquakes, and what is happening to the plate there?',
    tip: 'Project the explorer and fill in the first row of the table together.',
  },
  'contour-map': {
    hook: '“The map is flat. How can it tell a hiker which side of the hill is steeper?”',
    debrief: 'Where are the lines closest together, and what does that look like on the landscape? Which way does the river flow, and how can you tell?',
    tip: 'Give students two minutes to sculpt their own hill first. Their landscape stays in that browser until they press Reset landscape.',
  },
  'river-erosion': {
    hook: '“Why does a river cut a deep valley in the mountains but build new land where it meets the sea?”',
    debrief: 'Where did the river erode, and where did it drop sediment? Why does clay need faster water than sand to be picked up?',
    tip: 'Have pairs change one thing at a time (slope or flow) and compare the four setups on the board before trying gravel.',
  },
  'water-cycle': {
    hook: '“A drop of water in your glass may once have been in a glacier or deep underground. How could it get from the ocean to your tap, and how long might that take?”',
    debrief: 'Which moves needed the sun’s energy and which needed gravity? Why did the ocean take up almost all of the time?',
    tip: 'Give everyone chance code 10 for the worksheet, then let students pick their own codes and compare whose droplet traveled longest.',
  },
  'rock-cycle': {
    hook: '“The granite in a kitchen countertop could one day become a roof tile. How?”',
    debrief: 'Which steps needed energy from the sun, and which needed Earth’s internal heat? Where did your rock take a shortcut?',
    tip: 'Fill in the first row of the worksheet together, and show students that a dashed option explains why it can’t happen yet.',
  },
};

const standardCodes = [...new Set(activities.flatMap(act => act.standards))];
const usedBy = (code: string) => activities.filter(act => act.standards.includes(code)).map(act => act.toolName).join(' and ');
const notes = activities.filter(act => !act.standards.length && act.standardsNote);

const faq: [string, string][] = [
  ['Is Earth Science Lab free for classrooms?', 'Yes. Every lab, student activity and answer key is free, with no sign-up and no limit on the number of students.'],
  ['Do students need accounts or logins?', 'No. Students open a link and start. Nothing is saved to an account, and worksheets are completed on paper or in your own Classroom assignment.'],
  ['Does it work on Chromebooks and tablets?', 'Yes. The labs run in any modern browser, including Chrome on school Chromebooks and Safari on iPads, with nothing to install. JavaScript must be enabled. Every control works with a keyboard and on a touch screen.'],
  ['Will my students see ads?', adsLine],
  ['Which standards do the activities support?', 'The Epicenter Finder connects to NGSS MS-ESS3-2, the Plate Tectonics Explorer to MS-ESS2-3 and HS-ESS2-1, the River Erosion Sandbox to MS-ESS2-2 and HS-ESS2-5, the Water Cycle Explorer to MS-ESS2-4 and 5-ESS2-2, and the Rock Cycle Builder to MS-ESS2-1. The Contour Map Playground teaches the map-reading skills used in MS-ESS2-2 investigations. Each activity is a supplement to your curriculum, not a full unit.'],
  ['Can the whole class open the same setup?', 'Yes. Set a lab up the way you want and press Copy share link: everyone who opens that link sees the same settings. In the Epicenter Finder’s Challenge mode everyone gets the same three quakes, so scores can be compared fairly.'],
];
---
<Layout title="Earth Science Lab for Teachers: Free Activities & Answer Keys" description="Six free earth science virtual labs with printable worksheets and answer keys: earthquakes, plates, contour maps, rivers, water and rock cycles. No logins." section="For teachers" ads={false} crumbs={[['For teachers']]}>
  <div class="wrap">
    <div class="page-intro">
      <span class="eyebrow">For teachers</span>
      <h1>Earth Science Lab for teachers</h1>
      <p class="lede">Free interactive earth science labs with a printable student activity and an answer key for each. Students need no accounts, and the labs run on school Chromebooks with nothing to install.</p>
      <div class="page-actions">
        <a class="btn primary" href="#activities">See the activities</a>
        <span class="share-lead">Each lab has its own Share to Google Classroom button in the table below.</span>
      </div>
    </div>

    <section class="section" aria-labelledby="activities">
      <h2 id="activities">Ready-made classroom activities</h2>
      <p class="prose">Each activity is a one-page worksheet that walks students through the lab, with a results table and a set of questions. Times are for a typical class working in pairs.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Tool</th><th scope="col">Activity</th><th scope="col">Grades</th><th scope="col">Time</th><th scope="col">Standards</th><th scope="col">Resources</th></tr></thead>
          <tbody>
            {activities.map(act => (
              <tr>
                <td><a href={`/tools/${act.tool}/`}>{act.toolName}</a></td>
                <td>{act.title}</td>
                <td class="nowrap">{act.grade}</td>
                <td class="nowrap">{act.minutes} min</td>
                <td>{act.standards.length ? act.standards.map((code, i) => <>{i > 0 && ', '}<span class="nowrap">{code}</span></>) : 'Map-reading skills'}</td>
                <td class="resources"><a href={`/tools/${act.tool}/activity/`}>Student worksheet</a><br /><a href={`/teachers/answers/${act.tool}/`}>Answer key</a><br /><ClassroomShare url={toolUrl(act)} label={act.toolName} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section prose">
      <h2>Run a lab in 10–15 minutes</h2>
      <ol>
        <li><strong>Hook (2 min).</strong> Show the lab on the board and ask its opening question (below).</li>
        <li><strong>Explore (6–8 min).</strong> In pairs, students follow the worksheet steps and fill in the results table.</li>
        <li><strong>Questions (3 min).</strong> Questions 1–4 in class; the rest for early finishers or homework.</li>
        <li><strong>Debrief (2 min).</strong> Ask the debrief question. If time allows, finish with the lab’s Challenge mode.</li>
      </ol>
      <p>Before class, open the answer key: every number in it is calculated by the same model the lab uses, and automated tests check that they match.</p>
    </section>

    <section class="section" aria-labelledby="lesson-notes">
      <h2 id="lesson-notes">Opening and closing each lab</h2>
      <div class="grid-3">
        {activities.filter(act => lessonNotes[act.tool]).map(act => (
          <div class="card">
            <h3><a href={`/tools/${act.tool}/`}>{act.toolName}</a></h3>
            <p><strong>Hook:</strong> {lessonNotes[act.tool].hook}</p>
            <p><strong>Debrief:</strong> {lessonNotes[act.tool].debrief}</p>
            <p class="muted"><strong>Tip:</strong> {lessonNotes[act.tool].tip}</p>
            <p><a href={`/teachers/answers/${act.tool}/`}>Answer key →</a></p>
          </div>
        ))}
      </div>
    </section>

    <section class="section prose">
      <h2>Standards</h2>
      {standardCodes.map(code => <p><strong>NGSS {code}</strong> ({usedBy(code)}): {standards[code]}</p>)}
      {notes.map(act => <p><strong>{act.toolName}:</strong> {act.standardsNote}</p>)}
      <p>Science and engineering practices: analyzing and interpreting data; developing and using models; using mathematics and computational thinking. Each lab is a supplement to your curriculum rather than a complete unit.</p>
    </section>

    <section class="section">
      <div class="grid-3">
        <div class="card">
          <h3>Chromebooks, no logins</h3>
          <p>Runs in Chrome on Chromebooks and Safari on iPads, with nothing to install and no accounts. Every control works with a keyboard, and in the Epicenter Finder arrival times and distances can be typed instead of dragged.</p>
        </div>
        <div class="card">
          <h3>Student privacy</h3>
          <p>Students never enter a name or any personal details, and nothing about them is sent to us. The Contour Map Playground keeps a student’s sculpted landscape in that browser only. {tracking} Details are in the <a href="/privacy/">privacy policy</a>.</p>
        </div>
        <div class="card">
          <h3>Print-ready</h3>
          <p>Each worksheet and answer key prints on a single page. Use the Print button on each page, or paste the questions into your own Classroom assignment.</p>
        </div>
      </div>
    </section>

    <Faq items={faq} title="Questions teachers ask" eyebrow="Teacher FAQ" />
  </div>
</Layout>
