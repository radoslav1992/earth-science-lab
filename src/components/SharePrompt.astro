---
// After a "Share to Google Classroom" click, a small dismissible note invites the teacher to the teacher plan list on
// /teachers/#teacher-plan. No form and no third-party script. Rendered only when the waitlist is configured; once
// dismissed (or followed) it stays away for 30 days (waitlistPromptDismissed in local storage).
import { promptHref } from '../lib/waitlist.mjs';
---
<div class="share-prompt-region" role="status" data-share-prompt></div>
<template data-share-prompt-template>
  <div class="share-prompt">
    <p>Using this with a class? We’re planning a teacher plan — <a href={promptHref('/teachers/')} data-share-prompt-link>join the list</a></p>
    <button type="button" class="share-prompt-close" data-share-prompt-close aria-label="Dismiss"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
  </div>
</template>

<script>
  import { track } from '../lib/analytics';
  import { dismissPrompt, promptDismissed } from '../lib/waitlist.mjs';

  const region = document.querySelector<HTMLElement>('[data-share-prompt]');
  const template = document.querySelector<HTMLTemplateElement>('[data-share-prompt-template]');
  const storage = () => { try { return window.localStorage; } catch { return null; } };

  if (region && template) {
    document.addEventListener('click', event => {
      const target = event.target as Element | null;
      if (!target?.closest('[data-share-classroom], a[href^="https://classroom.google.com/share"]')) return;
      if (region.childElementCount || promptDismissed(storage())) return;
      region.append(template.content.cloneNode(true));
    }, true);
    region.addEventListener('click', event => {
      const target = event.target as Element | null;
      if (target?.closest('[data-share-prompt-link]')) {
        track('waitlist_prompt_click', { page: location.pathname });
        dismissPrompt(storage());
      } else if (target?.closest('[data-share-prompt-close]')) {
        dismissPrompt(storage());
        region.replaceChildren();
      }
    });
    region.addEventListener('keydown', event => {
      if (event.key === 'Escape' && region.childElementCount) {
        dismissPrompt(storage());
        region.replaceChildren();
      }
    });
  }
</script>

<style>
  .share-prompt-region { position: fixed; right: 16px; bottom: 16px; z-index: 61; max-width: min(400px, calc(100vw - 32px)); }
  /* While the cookie banner is open it owns the bottom of the screen. */
  :global(.cookie-banner:not([hidden])) ~ .share-prompt-region { bottom: auto; top: 16px; }
  .share-prompt { display: flex; align-items: flex-start; gap: 8px; padding: 12px 10px 12px 16px; border: 1px solid var(--line); border-left: 4px solid var(--ocean); border-radius: 12px; background: var(--surface); box-shadow: 0 8px 30px rgba(0, 0, 0, .18); font-size: .95rem; line-height: 1.45; }
  .share-prompt p { margin: 0; flex: 1; padding-top: 2px; }
  .share-prompt a { font-weight: 700; white-space: nowrap; }
  .share-prompt-close { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin: -6px 0 -6px; border: 0; border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; }
  .share-prompt-close:hover { background: var(--sand); color: var(--ink); }
  @media print { .share-prompt-region { display: none; } }
</style>
