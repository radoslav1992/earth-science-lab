---
// The fictional region used by the finder, worksheets and diagrams: 600 × 400 km, 1 SVG unit = 1 km,
// measured from the north-west corner (x east, y south). Slot "under" draws below the stations
// (circles), the default slot above them (markers).
import { REGION, STATIONS, TOWNS, COAST } from '../lib/seismology.mjs';

interface Props {
  label: string;
  id?: string;
  class?: string;
  interactive?: boolean;
}
const { label, id, class: className = '', interactive = false } = Astro.props;
const { width: W, height: H } = REGION;

// Smooth the coastline through its points (Catmull-Rom converted to cubic Béziers).
function smooth(points: number[][]) {
  let d = `M${points[0][0]} ${points[0][1]}`;
  for (let i = 0; i < points.length - 1; i++) {
    const [p0, p1, p2, p3] = [points[i - 1] ?? points[i], points[i], points[i + 1], points[i + 2] ?? points[i + 1]];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0]} ${p2[1]}`;
  }
  return d;
}
const coast = smooth(COAST);
const ocean = `${coast} L${W} ${H} L${W} 0 Z`;
const grid = Array.from({ length: W / 50 - 1 }, (_, i) => (i + 1) * 50);
const gridY = Array.from({ length: H / 50 - 1 }, (_, i) => (i + 1) * 50);
// Which side of each station its name sits on, so labels stay clear of the coast.
const anchor: Record<string, 'start' | 'end'> = { bayview: 'end' };
---
<svg
  class:list={['quake-map', className]}
  id={id}
  viewBox={`0 0 ${W} ${H}`}
  role={interactive ? 'application' : 'img'}
  aria-label={label}
  tabindex={interactive ? 0 : undefined}
  {...(interactive ? { 'data-map': '' } : {})}
>
  <rect class="land" width={W} height={H} />
  <path class="ocean" d={ocean} />
  <g aria-hidden="true">
    {grid.map(x => <line class:list={['grid-line', { major: x % 100 === 0 }]} x1={x} y1="0" x2={x} y2={H} />)}
    {gridY.map(y => <line class:list={['grid-line', { major: y % 100 === 0 }]} x1="0" y1={y} x2={W} y2={y} />)}
    {grid.filter(x => x % 100 === 0).map(x => <text class="grid-label" x={x + 4} y="14">{x}</text>)}
    {gridY.filter(y => y % 100 === 0).map(y => <text class="grid-label" x="4" y={y - 5}>{y}</text>)}
    <text class="grid-label" x="4" y="14">km</text>
    <path class="coast" d={coast} />
    <text class="ocean-label" x="0" y="0" transform="translate(578 262) rotate(90)">OCEAN</text>
    <g class="north" transform="translate(40 50)"><path d="M0 -16 L7 6 L0 1 L-7 6 Z" /><text x="0" y="22" text-anchor="middle">N</text></g>
    <g class="scale-bar" transform="translate(16 372)">
      <rect width="50" height="7" /><rect class="alt" x="50" width="50" height="7" />
      <text x="0" y="-5">0</text><text x="50" y="-5" text-anchor="middle">50</text><text x="100" y="-5" text-anchor="middle">100 km</text>
    </g>
    {TOWNS.map(town => <g class="town"><circle cx={town.x} cy={town.y} r="4" /><text x={town.x + 8} y={town.y + 4}>{town.name}</text></g>)}
  </g>
  <slot name="under" />
  <g class="stations">
    {STATIONS.map(st => (
      <g class="station" fill={st.color}>
        <path d={`M${st.x} ${st.y - 12} L${st.x + 10.5} ${st.y + 7} L${st.x - 10.5} ${st.y + 7} Z`} />
        <text x={anchor[st.id] === 'end' ? st.x - 14 : st.x + 14} y={st.y + 5} text-anchor={anchor[st.id] ?? 'start'}>{st.name}</text>
      </g>
    ))}
  </g>
  <slot />
</svg>
