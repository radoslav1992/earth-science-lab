---
// Plain "Share to Google Classroom" link (no Google script). The shared URL carries ?classroom so
// students who open it browse ad-free (see AdFree.astro); the page's canonical URL stays clean.
const { url, label } = Astro.props;
const href = `https://classroom.google.com/share?url=${encodeURIComponent(url + '?classroom=1')}`;
---
<a class:list={['classroom-share', { compact: label }]} href={href} target="_blank" rel="noopener" data-share-classroom><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="13" rx="2"/><circle cx="12" cy="9.2" r="2.2"/><path d="M8 15.2c.7-1.9 2.2-2.9 4-2.9s3.3 1 4 2.9M7 21h10M12 17v4"/></svg>{label ? <span><span class="visually-hidden">Share {label} to Google Classroom</span><span aria-hidden="true">Share</span></span> : <span>Share to Google Classroom</span>}</a>
